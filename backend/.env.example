# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/career_navigator

# ── Gemini ─────────────────────────────────────────────────────────────────────
# Required for real AI analysis. Get your key at https://aistudio.google.com/app/apikey
# Set MOCK_MODE=true to skip Gemini and use realistic demo data instead.
GEMINI_API_KEY=AIza...
# Primary model to use — gemini-3.7-flash is the recommended fast model
GEMINI_MODEL=gemini-3.7-flash
# Fallback models (comma-separated, tried in order if primary fails)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash

# ── Local LLM (Ollama) fallback ────────────────────────────────────────────────
# Fourth-tier fallback. Install Ollama from https://ollama.ai, then: ollama pull qwen2.5:3b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Grok (xAI) fallback ────────────────────────────────────────────────────────
# Second-tier fallback. Get API key at https://console.x.ai
GROK_ENABLED=false
GROK_API_KEY=
GROK_MODEL=grok-beta

# ── NVIDIA API Catalog fallback ────────────────────────────────────────────────
# Third-tier fallback. Get API key at https://build.nvidia.com
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── Mock mode ──────────────────────────────────────────────────────────────────
# true  → skip all Gemini calls, return realistic hardcoded demo results
# false → use real Gemini 1.5 Flash analysis (requires a Gemini API key)
MOCK_MODE=false

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Optional but recommended — raises API rate limit from 60 → 5 000 req/hour.
# Generate at: github.com → Settings → Developer settings → Personal access tokens
# Scopes needed: public_repo (read-only is fine)
GITHUB_TOKEN=ghp_...

# ── AI module service URLs (teammates run these independently) ─────────────────
GITHUB_AGENT_URL=http://localhost:8001
RESUME_JUDGE_URL=http://localhost:8002
PROJECT_RECOMMENDER_URL=http://localhost:8003
ROADMAP_GENERATOR_URL=http://localhost:8004

# ── HTTP timeouts (seconds) ────────────────────────────────────────────────────
SERVICE_TIMEOUT=30.0
SERVICE_CONNECT_TIMEOUT=5.0

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DEBUG=false

# ── CORS (comma-separated list of allowed origins) ─────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/tmp/career_navigator_uploads
